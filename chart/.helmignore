# Patterns to ignore when building packages.
.DS_Store
.git/
.gitignore
*.tmp
*.bak
*.swp
*.orig
.idea/
.vscode/
# chart tests are dev-only assertions, not part of the runtime package
tests/
# Dockerfile.console is a build input for paas-ci (bakes the console image),
# not a runtime asset of the chart package.
Dockerfile.console
