+_PI_PROVIDER_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*")
+
+
+def _ambient_pi_model_options(agent_dir: Path | None = None) -> list[dict[str, object]]:
+    """List the models Pi itself reports, without launching a session.
+
+    Pi reads providers from places this module does not model: an API key in
+    the environment (``OPENROUTER_API_KEY`` and friends), or a built-in
+    provider that ``models.json`` merely overrides. ``pi --list-models`` already
+    resolves all of that, so the picker asks it when the files came up empty.
+    The file-based answer still wins whenever it is non-empty.
+
+    Total by contract: a missing CLI, a failure, a timeout, or output that is
+    not Pi's model table yields ``[]`` and never raises. With nothing
+    configured Pi prints a "No models available" notice instead of a table, so
+    only lines after the ``provider  model ...`` header are read as models.
+
+    :param agent_dir: Pi agent dir override (tests); defaults to the host's own.
+    """
+    env = None if agent_dir is None else {**os.environ, PI_CODING_AGENT_DIR_ENV_VAR: str(agent_dir)}
+    try:
+        result = subprocess.run(
+            ["pi", "--list-models"],
+            capture_output=True,
+            text=True,
+            errors="replace",
+            # About a second where measured; the host RPC that asks is cut off at
+            # fifteen seconds, so stay clear of that.
+            timeout=12,
+            check=False,
+            stdin=subprocess.DEVNULL,
+            env=env,
+        )
+    except (OSError, subprocess.SubprocessError):
+        _LOGGER.info("pi-native: could not run `pi --list-models` for the model picker")
+        return []
+    if result.returncode != 0:
+        _LOGGER.info("pi-native: `pi --list-models` failed; leaving the model picker empty")
+        return []
+    options: dict[str, dict[str, object]] = {}
+    in_table = False
+    for line in result.stdout.splitlines():
+        columns = line.split()
+        if not in_table:
+            in_table = columns[:2] == ["provider", "model"]
+            continue
+        if len(columns) < 2 or not _PI_PROVIDER_ID.fullmatch(columns[0]):
+            continue
+        qualified = f"{columns[0]}/{columns[1]}"
+        options[qualified] = {"id": qualified, "model": qualified, "displayName": columns[1]}
     return [options[model_id] for model_id in sorted(options)]
 
 
