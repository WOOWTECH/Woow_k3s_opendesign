# OpenDesign base built from the WoowTech fork (woow-paas/open-design) by
# build-open-design-image.yml, then used as OD_BASE for open-design/Dockerfile.
#
# The fork's deploy/Dockerfile is upstream's own strict build (pnpm install
# --frozen-lockfile, no `|| true`); ghcr.io/nexu-io/od:0.24.1 is built from the
# same file with the same node base, so every layer below the daemon/web output
# matches upstream. Bump = new fork tag + its commit SHA together (the workflow
# fails when the tag does not resolve to OD_SOURCE_SHA).
OD_SOURCE_REPO=woow-paas/open-design
OD_SOURCE_TAG=woow-od-v0.24.1-w2.11
OD_SOURCE_SHA=05b23f5a5259d4f2c22e5c6e3eb92ce9103ed34a
# Upstream release the fork builds on (must be an ancestor of OD_SOURCE_SHA).
OD_UPSTREAM_TAG=open-design-v0.24.1
OD_UPSTREAM_SHA=89e64d813bb1c7a11519b3f668f011f7017637d7
OD_UPSTREAM_VERSION=0.24.1
# node:24.21.0-alpine3.24 (alpine 3.24.2) by index digest = the base of ghcr.io/nexu-io/od:0.24.1.
OD_NODE_IMAGE=docker.io/library/node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
