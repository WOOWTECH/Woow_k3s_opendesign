# =============================================================================
# .gitignore -- this repository is PUBLIC.
# =============================================================================
# The 1.x chart leaked a real 64-hex JWT key, an admin password and a ttyd
# password by committing them in values.yaml. The 2.0.0 chart holds no secret
# at all, and tests/validate.py fails the build if one reappears in
# chart/values.yaml. This file is the second line: it keeps the local files
# that DO hold credentials -- values overrides, kubeconfigs, env files --
# from ever being staged. See docs/MIGRATION.md.

# --- Local Helm values overrides (these hold real hostnames and, historically,
# --- real secrets). chart/values.yaml and tests/values/ stay tracked.
values.local.yaml
values-local.yaml
*.local.yaml
*.local.yml
my-values.yaml
values.override.yaml
values-override.yaml
override-values.yaml
secrets.yaml
secret-values.yaml
*.secrets.yaml
!chart/values.yaml
!tests/values/*.yaml

# --- Cluster credentials
kubeconfig
kubeconfig-*
*.kubeconfig
.kube/
*.kubeconfig.yaml
admin.conf

# --- Generic credential material
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
htpasswd
.htpasswd

# --- Helm build output
*.tgz
chart/charts/
chart/Chart.lock
chart/requirements.lock
helm-render.yaml
rendered.yaml

# --- Container / build artifacts
*.tar
*.tar.gz

# --- Node
node_modules/
npm-debug.log*

# --- Test scratch
tests/.tmp/
tests/out/
.playwright-mcp/

# --- Editors and OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
